# Lokal ve anahtarsız kullanım için güvenli varsayılanlar
COMPOSE_PROJECT_NAME=health-tourism-regulations
PUID=1000
PGID=1000
DM_DATA_DIR=./data
DM_TRANSPORT=stdio
DM_HOST=127.0.0.1
DM_PORT=8000
DM_ENVIRONMENT=development
DM_PUBLIC_BASE_URL=
DM_ALLOWED_HOSTS=localhost,127.0.0.1,health-tourism-regulations-mcp
DM_MAX_SOURCE_BYTES=15000000
DM_REQUEST_TIMEOUT=30
DM_MAX_REQUEST_BYTES=1048576
DM_RATE_LIMIT_PER_MINUTE=60
DM_TOOL_TIMEOUT=20
DM_LOG_RETENTION_DAYS=0
DM_SOURCE_ALLOWED_DOMAINS=resmigazete.gov.tr,saglik.gov.tr,kvkk.gov.tr,ushas.com.tr,healthturkiye.com,ticaret.gov.tr,tdb.org.tr

# OpenAI submission portalı bir domain doğrulama tokenı verdiğinde doldurun.
OPENAI_APPS_CHALLENGE_TOKEN=

# İsteğe bağlı semantik arama
# DM_EMBEDDING_API_KEY=
