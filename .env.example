# Lokal ve anahtarsız kullanım için güvenli varsayılanlar
DM_DATA_DIR=./data
DM_ENABLE_ADMIN_TOOLS=false
DM_TRANSPORT=stdio
DM_HOST=127.0.0.1
DM_PORT=8000
DM_MAX_SOURCE_BYTES=15000000
DM_REQUEST_TIMEOUT=30

